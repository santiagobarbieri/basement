{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BASEMENT", "version": "0.1.0", "identifier": "com.basement.desktop",
  "build": { "frontendDist": "../public" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "BASEMENT", "width": 1512, "height": 982, "minWidth": 900, "minHeight": 660, "resizable": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true, "targets": ["app"], "icon": ["icons/icon.png", "icons/icon.icns"],
    "fileAssociations": [{ "ext": ["artboard"], "name": "BASEMENT Artboard", "description": "BASEMENT Artboard", "role": "Editor" }],
    "macOS": { "minimumSystemVersion": "13.0", "infoPlist": "Info.plist" }
  }
}
